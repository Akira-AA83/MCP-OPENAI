{
  "name": "mcp-openai-astra",
  "version": "0.2.0",
  "description": "MCP server giving Claude Code an independent second opinion from OpenAI models: openai_chat plus an autonomous agent (astra_investigate) that inspects the project through its MCP servers",
  "license": "MIT",
  "author": "Augusto Angeletti",
  "contributors": [
    "mzxrai (original mcp-openai)"
  ],
  "homepage": "https://github.com/Akira-AA83/MCP-OPENAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akira-AA83/MCP-OPENAI.git"
  },
  "bugs": "https://github.com/Akira-AA83/MCP-OPENAI/issues",
  "type": "module",
  "bin": {
    "mcp-openai-astra": "dist/index.js"
  },
  "files": [
    "dist",
    "hooks"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "openai",
    "gpt-6-astra",
    "agent",
    "second-opinion",
    "unreal-engine"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "shx": "^0.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
